@model IEnumerable<KolevMetal.ViewModels.Product.ProductIndexViewModel>

@{
    ViewData["Title"] = "Продукти";
}


<section class="products-section">

    <div class="container">

        <!-- TITLE -->
        <div class="products-simple-heading reveal-up">

            <span class="products-heading-line"></span>

            <h1>ПРОДУКТИ</h1>

            <span class="products-heading-line"></span>

        </div>


        <!-- NO PRODUCTS -->
        @if (!Model.Any())
        {
            <div class="products-empty reveal-up">

                <span>КОЛЕВ МЕТАЛ</span>

                <h3>
                    ПРОДУКТИТЕ<br />
                    <strong>ПРЕДСТОЯТ.</strong>
                </h3>

                <p>
                    Каталогът се подготвя.
                    Скоро тук ще бъдат представени нашите продукти.
                </p>

            </div>
        }

        <!-- PRODUCTS -->
        else
        {
        <div class="products-grid">

            @foreach (var product in Model)
            {
                <article class="product-card reveal-up">


                    <!-- PRODUCT IMAGE -->
                    <div class="product-card-image">

                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Name" />
                        }
                        else
                        {
                            <div class="product-no-image">
                                <span>KM</span>
                            </div>
                        }

                        <div class="product-image-overlay"></div>

                    </div>


                    <!-- PRODUCT CONTENT -->
                    <div class="product-card-content">


                        <!-- CATEGORY -->
                        <span class="product-category">
                            @product.CategoryName
                        </span>


                        <!-- NAME -->
                        <h3>
                            @product.Name
                        </h3>


                        <!-- DESCRIPTION -->
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <p class="product-description">
                                @product.Description
                            </p>
                        }


                        <!-- PRICE -->
                        <div class="product-price">
                            @product.Price.ToString("F2") €
                        </div>


                        <!-- PURCHASE -->
                        <div class="product-purchase">


                            <!-- QUANTITY -->
                            <div class="product-quantity">

                                <button type="button"
                                        class="quantity-button"
                                        onclick="decreaseQuantity(@product.Id)">
                                    −
                                </button>


                                <input type="number"
                                       id="quantity-@product.Id"
                                       class="quantity-input"
                                       value="1"
                                       min="1"
                                       readonly />


                                <button type="button"
                                        class="quantity-button"
                                        onclick="increaseQuantity(@product.Id)">
                                    +
                                </button>

                            </div>


                            <!-- ADD TO CART -->
                            <button type="button"
                                    class="add-to-cart-button">

                                <span>
                                    ДОБАВИ В КОЛИЧКАТА
                                </span>

                                
                            </button>

                        </div>

                    </div>

                </article>
            }

        </div>
        }

    </div>

</section>



<!-- CUSTOM PRODUCT CTA -->
<section class="products-cta">

    <div class="container">

        <div class="products-cta-inner reveal-up">

            <span>
                НЕ НАМИРАТЕ ТОВА, КОЕТО ТЪРСИТЕ?
            </span>


            <h2>
                ИМАТЕ СОБСТВЕНА<br />
                <strong>ИДЕЯ ОТ МЕТАЛ?</strong>
            </h2>


            <p>
                Изпратете ни чертеж, размери или описание
                на Вашия проект.
            </p>


            <a href="/#contact"
               class="km-btn km-btn-primary">

                ИЗПРАТИ ЗАПИТВАНЕ

            </a>

        </div>

    </div>

</section>



<!-- QUANTITY JAVASCRIPT -->
<script>

    function increaseQuantity(productId) {

        const input =
            document.getElementById("quantity-" + productId);

        const currentValue =
            parseInt(input.value);

        input.value = currentValue + 1;
    }


    function decreaseQuantity(productId) {

        const input =
            document.getElementById("quantity-" + productId);

        const currentValue =
            parseInt(input.value);

        if (currentValue > 1) {

            input.value = currentValue - 1;

        }
    }

</script>