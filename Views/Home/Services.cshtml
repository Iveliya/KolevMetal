@{
    ViewData["Title"] = "Услуги";
}

<!-- ==========================================
     HERO
========================================== -->

<section class="services-hero">

    <div class="services-hero-overlay"></div>

    <div class="container services-hero-container">

        <div class="services-hero-content">

            <span class="services-eyebrow reveal-left">
                КОЛЕВ МЕТАЛ / УСЛУГИ
            </span>

            <h1 class="reveal-left">
                ПРЕЦИЗНОСТ<br />
                ОТ ИДЕЯТА ДО<br />
                <span>ГОТОВИЯ ДЕТАЙЛ.</span>
            </h1>

            <p class="reveal-left">
                Съвременни технологии, натрупан опит
                и внимание към всеки етап от изработката.
            </p>

        </div>

    </div>

    <div class="services-hero-number">
        03
    </div>
    <a href="#services-list" class="services-scroll">
        <span class="services-scroll-text">
            РАЗГЛЕДАЙ НАШИТЕ УСЛУГИ
        </span>

        <span class="services-scroll-arrow">
            ↓
        </span>
    </a>

</section>


<!-- ==========================================
     INTRO
========================================== -->

<section class="services-intro">

    <div class="container">

        <div class="row align-items-end">

            <div class="col-lg-7 reveal-left">

                <span class="km-section-number">01</span>
                <span class="km-section-label">КАКВО ПРАВИМ</span>

            </div>

        </div>

    </div>

</section>


<!-- ==========================================
     SERVICES
========================================== -->

<section id="services-list" class="services-list">


    <!-- ==========================================
         01 - ЛАЗЕРНО РЯЗАНЕ
    ========================================== -->

    <article class="service-feature">

        <div class="container">

            <div class="row align-items-center g-5">

                <!-- IMAGE -->
                <div class="col-lg-7 reveal-left">

                    <div class="service-feature-image">

                        <img src="~/images/KM19.png"
                             alt="Лазерно рязане на метал" />

                        <span class="service-image-number">
                            01
                        </span>

                    </div>

                </div>


                <!-- CONTENT -->
                <div class="col-lg-5 reveal-right">

                    <div class="service-feature-content">

                        <span class="service-small-label">
                            ПРЕЦИЗНО РЯЗАНЕ
                        </span>

                        <h2>
                            ЛАЗЕРНО<br />
                            <span>РЯЗАНЕ</span>
                        </h2>

                        <div class="km-orange-line"></div>

                        <p>
                            Прецизно изрязване на метални детайли
                            според зададени размери, технически чертеж
                            или индивидуален проект.
                        </p>

                        <div class="service-points">

                            <div>
                                <span>01</span>
                                <p>Висока точност</p>
                            </div>

                            <div>
                                <span>02</span>
                                <p>Чисти контури</p>
                            </div>

                            <div>
                                <span>03</span>
                                <p>Сложни форми</p>
                            </div>

                            <div>
                                <span>04</span>
                                <p>Работа по чертеж</p>
                            </div>

                        </div>

                        <a href="#service-contact"
                           class="service-link">
                            ИЗПРАТИ ЗАПИТВАНЕ
                            <span>↗</span>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </article>


    <!-- ==========================================
         02 - МЕТАЛООБРАБОТКА
    ========================================== -->

    <article class="service-feature service-feature-reverse">

        <div class="container">

            <div class="row align-items-center g-5">

                <!-- CONTENT -->
                <div class="col-lg-5 order-2 order-lg-1 reveal-left">

                    <div class="service-feature-content">

                        <span class="service-small-label">
                            ПРЕЦИЗНА ОБРАБОТКА
                        </span>

                        <h2>
                            МЕТАЛО<br />
                            <span>ОБРАБОТКА</span>
                        </h2>

                        <div class="km-orange-line"></div>

                        <p>
                            Обработка на метални детайли с внимание
                            към точността, функционалността
                            и качеството на крайния резултат.
                        </p>

                        <div class="service-points">

                            <div>
                                <span>01</span>
                                <p>Прецизна обработка</p>
                            </div>

                            <div>
                                <span>02</span>
                                <p>Работа по проект</p>
                            </div>

                            <div>
                                <span>03</span>
                                <p>Точни размери</p>
                            </div>

                            <div>
                                <span>04</span>
                                <p>Контрол на детайла</p>
                            </div>

                        </div>

                        <a href="#service-contact"
                           class="service-link">
                            ИЗПРАТИ ЗАПИТВАНЕ
                            <span>↗</span>
                        </a>

                    </div>

                </div>


                <!-- IMAGE -->
                <div class="col-lg-7 order-1 order-lg-2 reveal-right">

                    <div class="service-feature-image">

                        <img src="~/images/KM18.png"
                             alt="Металообработка на метални детайли" />

                        <span class="service-image-number">
                            02
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </article>


    <!-- ==========================================
         03 - ПРАХОВО БОЯДИСВАНЕ
    ========================================== -->

    <article class="service-feature">

        <div class="container">

            <div class="row align-items-center g-5">

                <!-- IMAGE -->
                <div class="col-lg-7 reveal-left">

                    <div class="service-feature-image">

                        <img src="~/images/KM16.png"
                             alt="Прахово боядисване на метални детайли" />

                        <span class="service-image-number">
                            03
                        </span>

                    </div>

                </div>


                <!-- CONTENT -->
                <div class="col-lg-5 reveal-right">

                    <div class="service-feature-content">

                        <span class="service-small-label">
                            ЗАВЪРШВАЩО ПОКРИТИЕ
                        </span>

                        <h2>
                            ПРАХОВО<br />
                            <span>БОЯДИСВАНЕ</span>
                        </h2>

                        <div class="km-orange-line"></div>

                        <p>
                            Завършваща обработка на метални изделия
                            за равномерно покритие, устойчивост
                            и професионален краен вид.
                        </p>

                        <div class="service-points">

                            <div>
                                <span>01</span>
                                <p>Равномерно покритие</p>
                            </div>

                            <div>
                                <span>02</span>
                                <p>Устойчивост</p>
                            </div>

                            <div>
                                <span>03</span>
                                <p>Различни цветове</p>
                            </div>

                            <div>
                                <span>04</span>
                                <p>Завършен вид</p>
                            </div>

                        </div>

                        <a href="#service-contact"
                           class="service-link">
                            ИЗПРАТИ ЗАПИТВАНЕ
                            <span>↗</span>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </article>

</section>


<!-- ==========================================
     PROCESS
========================================== -->

<section class="services-process">

    <div class="container">

        <div class="services-process-heading reveal-up">

            <span class="km-section-number">02</span>
            <span class="km-section-label">КАК РАБОТИМ</span>

            <h2>
                ОТ ИДЕЯТА<br />
                <span>ДО ГОТОВИЯ ДЕТАЙЛ.</span>
            </h2>

        </div>


        <div class="services-process-list">

            <!-- STEP 01 -->
            <div class="process-row reveal-up">

                <span class="process-number">01</span>

                <h3>ЗАПИТВАНЕ</h3>

                <p>
                    Изпращате информация за проекта,
                    размери, описание или чертеж.
                </p>

            </div>


            <!-- STEP 02 -->
            <div class="process-row reveal-up">

                <span class="process-number">02</span>

                <h3>ПРЕГЛЕД НА ПРОЕКТА</h3>

                <p>
                    Разглеждаме изискванията и уточняваме
                    необходимите детайли.
                </p>

            </div>


            <!-- STEP 03 -->
            <div class="process-row reveal-up">

                <span class="process-number">03</span>

                <h3>ИЗРАБОТКА</h3>

                <p>
                    Проектът преминава към съответния
                    производствен процес.
                </p>

            </div>


            <!-- STEP 04 -->
            <div class="process-row reveal-up">

                <span class="process-number">04</span>

                <h3>ГОТОВ ПРОДУКТ</h3>

                <p>
                    Завършеният детайл е готов
                    за предаване на клиента.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ==========================================
     FINAL CTA
========================================== -->

<section id="service-contact"
         class="services-final">

    <div class="services-final-overlay"></div>

    <div class="container">

        <div class="services-final-content reveal-up">

            <span>
                ИНДИВИДУАЛНИ РЕШЕНИЯ
            </span>

            <h2>
                ИМАТЕ НЕСТАНДАРТЕН<br />
                <strong>ПРОЕКТ?</strong>
            </h2>

            <p>
                Изпратете ни чертеж, размери или описание
                на това, което искате да бъде изработено.
            </p>

            <a href="#"
               class="km-btn km-btn-primary">
                ИЗПРАТИ ЗАПИТВАНЕ
            </a>

        </div>

    </div>

</section>