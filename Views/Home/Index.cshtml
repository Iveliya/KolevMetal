@{
    ViewData["Title"] = "Начало";
}

<section class="hero-section">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <div class="hero-small-title">
            КАЧЕСТВО • ПРЕЦИЗНОСТ • НАДЕЖДНОСТ
        </div>

        <h1>
            МЕТАЛЪТ Е НАШАТА
            <span>СИЛА.</span>
        </h1>

        <p>
            Професионална металообработка, лазерно рязане,
            прахово боядисване и производство на метални изделия.
        </p>

        <div class="hero-buttons">

            <a href="#services" class="btn-main">
                НАШИТЕ УСЛУГИ
            </a>

            <a href="#contact" class="btn-outline-custom">
                НАПРАВИ ЗАПИТВАНЕ
            </a>

        </div>

    </div>

</section>


<section class="company-highlights">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4 highlight-item">
                <h3>ПРЕЦИЗНОСТ</h3>
                <p>Съвременно оборудване и качествена обработка</p>
            </div>

            <div class="col-md-4 highlight-item">
                <h3>КАЧЕСТВО</h3>
                <p>Внимание към всеки детайл и всеки проект</p>
            </div>

            <div class="col-md-4 highlight-item">
                <h3>НАДЕЖДНОСТ</h3>
                <p>Коректност и професионално изпълнение</p>
            </div>

        </div>

    </div>

</section>