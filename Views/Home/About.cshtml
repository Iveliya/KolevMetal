@* @page
@model KolevMetal.Views.Home.AboutModel
@{
}

@{
    ViewData["Title"] = "За нас";
} *@

<!-- ABOUT HERO -->
<section class="about-hero">

    <div class="about-hero-overlay"></div>

    <div class="container about-hero-content">

        <div class="about-hero-text">

            <span class="about-eyebrow reveal-left">
                КОЛЕВ МЕТАЛ
            </span>

            <h1 class="reveal-left">
                НАД <span>20 ГОДИНИ</span><br />
                ОПИТ В МЕТАЛА.
            </h1>

            <p class="reveal-left">
                Опит, технологии и внимание към детайла,
                превърнати в решения от метал.
            </p>

        </div>

    </div>

    <div class="about-hero-number">
        20+
    </div>

</section>


<!-- STORY -->
<section class="about-story">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6 reveal-left">

                <span class="km-section-number">01</span>
                <span class="km-section-label">НАШАТА ИСТОРИЯ</span>

                <h2 class="about-title">
                    ИЗГРАДЕНО<br />
                    <span>С ГОДИНИТЕ.</span>
                </h2>

                <div class="km-orange-line"></div>

                <p class="about-lead">
                    Повече от две десетилетия „Колев Метал“
                    развива своя опит в областта на
                    металообработката.
                </p>

                <p>
                    Създадена от <strong>Николай Колев</strong>,
                    компанията се развива с фокус върху
                    прецизността, надеждността и качественото
                    изпълнение.
                </p>

                <p>
                    Натрупаният през годините опит се съчетава
                    със съвременни технологии и индивидуален
                    подход към всеки проект.
                </p>

            </div>


            <div class="col-lg-6 reveal-right">

                <div class="about-story-image">

                    <img src="~/images/KM1.png"
                         alt="Колев Метал производство" />

                    <div class="about-image-frame"></div>

                    <div class="about-image-label">
                        <strong>20+</strong>
                        <span>ГОДИНИ ОПИТ</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- BIG STATEMENT -->
<section class="about-statement">

    <div class="container">

        <div class="about-statement-inner reveal-up">

            <span class="about-quote-mark">“</span>

            <h2>
                НЕ ПРОСТО ОБРАБОТВАМЕ МЕТАЛ.
                <span>
                    СЪЗДАВАМЕ РЕШЕНИЯ.
                </span>
            </h2>

            <div class="about-statement-line"></div>

            <p>
                КОЛЕВ МЕТАЛ
            </p>

        </div>

    </div>

</section>


<!-- VALUES -->
<section class="about-values">

    <div class="container">

        <div class="about-values-heading reveal-up">

            <span class="km-section-number">02</span>
            <span class="km-section-label">НАШИТЕ ЦЕННОСТИ</span>

            <h2>
                ТОВА, КОЕТО<br />
                <span>СТОИ ЗАД РАБОТАТА НИ.</span>
            </h2>

        </div>


        <div class="about-values-list">

            <div class="about-value-row reveal-up">
                <div class="about-value-big-number">01</div>

                <div class="about-value-main">
                    <span>ТОЧНОСТ ВЪВ ВСЕКИ ДЕТАЙЛ</span>
                    <h3>ПРЕЦИЗНОСТ</h3>
                </div>

                <p>
                    Внимание към размерите, обработката
                    и всеки детайл от крайния резултат.
                </p>

                <div class="about-value-arrow">↗</div>
            </div>


            <div class="about-value-row reveal-up">
                <div class="about-value-big-number">02</div>

                <div class="about-value-main">
                    <span>ОТГОВОРНОСТ В ПРОЦЕСА</span>
                    <h3>НАДЕЖДНОСТ</h3>
                </div>

                <p>
                    Отговорен подход и последователност
                    във всяка стъпка от изпълнението.
                </p>

                <div class="about-value-arrow">↗</div>
            </div>


            <div class="about-value-row reveal-up">
                <div class="about-value-big-number">03</div>

                <div class="about-value-main">
                    <span>БЕЗ КОМПРОМИС В ИЗПЪЛНЕНИЕТО</span>
                    <h3>КАЧЕСТВО</h3>
                </div>

                <p>
                    Стремеж към професионално изпълнение
                    и завършен резултат.
                </p>

                <div class="about-value-arrow">↗</div>
            </div>

        </div>

    </div>

</section>


<!-- NUMBERS -->
<section class="about-numbers">

    <div class="container">

        <div class="about-numbers-grid">

            <div class="about-number-item reveal-up">

                <strong class="counter" data-target="20">
                    0
                </strong>

                <span class="counter-plus">+</span>

                <p>ГОДИНИ ОПИТ</p>

            </div>


            <div class="about-number-divider"></div>


            <div class="about-number-item reveal-up">

                <strong class="counter" data-target="3">
                    0
                </strong>

                <p>ОСНОВНИ НАПРАВЛЕНИЯ</p>

            </div>


            <div class="about-number-divider"></div>


            <div class="about-number-item reveal-up">

                <strong>01</strong>

                <p>ЦЕЛ — КАЧЕСТВО</p>

            </div>

        </div>

    </div>

</section>


<!-- TECHNOLOGY -->
<section class="about-technology">

    <div class="about-technology-bg"></div>

    <div class="about-technology-overlay"></div>

    <div class="container">

        <div class="about-technology-content reveal-left">

            <span class="km-section-number">03</span>
            <span class="km-section-label">ПРОИЗВОДСТВО</span>

            <h2>
                ОПИТЪТ СРЕЩА<br />
                <span>ТЕХНОЛОГИЯТА.</span>
            </h2>

            <div class="km-orange-line"></div>

            <p>
                Съчетаваме натрупания през годините опит
                със съвременни методи за обработка на метал,
                за да превърнем проекта в завършен продукт.
            </p>

            <a href="/#services" class="km-btn km-btn-primary">
                РАЗГЛЕДАЙ УСЛУГИТЕ
            </a>

        </div>

    </div>

</section>


<!-- FINAL CTA -->
<section class="about-final">

    <div class="container">

        <div class="about-final-content reveal-up">

            <span>
                ИМАТЕ ПРОЕКТ?
            </span>

            <h2>
                НЕКА СЪЗДАДЕМ<br />
                <strong>НЕЩО ОТ МЕТАЛ.</strong>
            </h2>

            <p>
                Разкажете ни за Вашата идея.
            </p>

            <a href="/#contact"
               class="km-btn km-btn-primary">
                ИЗПРАТИ ЗАПИТВАНЕ
            </a>

        </div>

    </div>

</section>
